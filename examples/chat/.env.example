# Copy to .env. The demo runs offline with these defaults.
GREATAPI_SECRET_KEY=demo-only-key-replace-me-000000000000000000000000000000000
GREATAPI_DEBUG=true
GREATAPI_DATABASE_URL=sqlite+aiosqlite:///./demo.db
GREATAPI_AI_DEFAULT_MODEL=echo:demo

# A real model instead:
# GREATAPI_AI_DEFAULT_MODEL=anthropic:claude-sonnet-5
# GREATAPI_ANTHROPIC_API_KEY=

# A local one (needs greatapi[local], which is just httpx):
# GREATAPI_AI_DEFAULT_MODEL=local:llama3.2
# GREATAPI_OPENAI_BASE_URL=http://localhost:11434/v1
