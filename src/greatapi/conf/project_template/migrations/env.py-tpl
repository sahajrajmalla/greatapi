"""Alembic environment.

Short because the async plumbing lives in the installed package, where it can
be fixed by upgrading GreatAPI rather than by editing this file in every project
that has ever run startproject.
"""

from __future__ import annotations

from greatapi.apps import load_models
from greatapi.db import Base
from greatapi.db.migrations import run_migrations

from {{ project_name }}.settings import INSTALLED_APPS

# Importing each app's models is what puts its tables into Base.metadata, and
# therefore what lets autogenerate see them.
load_models(INSTALLED_APPS)

run_migrations(Base.metadata)
