# Copy to .env and adjust. .env is git-ignored; .env.example is not.

# Signing key for sessions and tokens. Generate one with: greatapi generate-secret
GREATAPI_SECRET_KEY={{ secret_key }}

# Developer conveniences: verbose errors, tables created on boot, insecure cookies
# over plain HTTP. Never enable in production.
GREATAPI_DEBUG=true

# Any SQLAlchemy *async* URL.
GREATAPI_DATABASE_URL=sqlite+aiosqlite:///./{{ project_name }}.db
# GREATAPI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/{{ project_name }}

# --- AI (needs: pip install "greatapi[ai]") ----------------------------------
# echo:demo is a built-in offline model. No key, no network, no cost.
GREATAPI_AI_DEFAULT_MODEL=echo:demo
# GREATAPI_ANTHROPIC_API_KEY=
# GREATAPI_OPENAI_API_KEY=
# Point the `local:` provider at Ollama, vLLM or LM Studio:
# GREATAPI_OPENAI_BASE_URL=http://localhost:11434/v1

# What you pay, in USD per million tokens, so the admin can report cost.
# GREATAPI_AI_PRICING={"anthropic:claude-sonnet-5": [3.0, 15.0]}
